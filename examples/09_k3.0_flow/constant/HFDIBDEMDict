FoamFile
{
    version         2;
    format          ascii;
    class           dictionary;
    location        "constant";
    object          HFDIBDEMDict;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

bodyNames       ( "PH_SC_prefill" "PH_SC_inlet" );

interpolationSchemes
{
    U               cell;
}

surfaceThreshold 0.0001;

stepDEM         0.002;

geometricD      ( 1 1 1 );

recordSimulation true;

recordFirstTimeStep true;

nSolidsInDomain 3000;

outputSetup
{
    basic       false;
    iB          false;
    DEM         false;
    addModel    true;
    addModelVerbosity summary;
    parallelDEM false;
}

DEM
{
    LcCoeff        4.0;
    rotationModel  mindlin1953;

    materials
    {
        particle
        {
            Y       5e8;
            nu      0.5;
            mu      1.0;
            adhN    0;
            eps     0.75;
        }

        wall
        {
            Y       5e8;
            nu      0.5;
            mu      1.0;
            adhN    0;
            eps     0.75;
        }
    }

    cyclicPatches
    {
    }

    collisionPatches
    {
        // Downstream 10 mm x 10 mm throat, y = 0--25 mm.
        xMin_small
        {
            material    wall;
            nVec        (-1 0 0);
            planePoint  (-0.005 0 0);

            finitePatch true;
            minBound    (-0.005 0.000 -0.005);
            maxBound    (-0.005 0.025  0.005);
        }

        xMax_small
        {
            material    wall;
            nVec        (1 0 0);
            planePoint  (0.005 0 0);

            finitePatch true;
            minBound    (0.005 0.000 -0.005);
            maxBound    (0.005 0.025  0.005);
        }

        zMin_small
        {
            material    wall;
            nVec        (0 0 -1);
            planePoint  (0 0 -0.005);

            finitePatch true;
            minBound    (-0.005 0.000 -0.005);
            maxBound    ( 0.005 0.025 -0.005);
        }

        zMax_small
        {
            material    wall;
            nVec        (0 0 1);
            planePoint  (0 0 0.005);

            finitePatch true;
            minBound    (-0.005 0.000 0.005);
            maxBound    ( 0.005 0.025 0.005);
        }

        // Upstream 40 mm x 40 mm reservoir, y = 25--75 mm.
        xMin_large
        {
            material    wall;
            nVec        (-1 0 0);
            planePoint  (-0.020 0 0);

            finitePatch true;
            minBound    (-0.020 0.025 -0.020);
            maxBound    (-0.020 0.075  0.020);
        }

        xMax_large
        {
            material    wall;
            nVec        (1 0 0);
            planePoint  (0.020 0 0);

            finitePatch true;
            minBound    (0.020 0.025 -0.020);
            maxBound    (0.020 0.075  0.020);
        }

        zMin_large
        {
            material    wall;
            nVec        (0 0 -1);
            planePoint  (0 0 -0.020);

            finitePatch true;
            minBound    (-0.020 0.025 -0.020);
            maxBound    ( 0.020 0.075 -0.020);
        }

        zMax_large
        {
            material    wall;
            nVec        (0 0 1);
            planePoint  (0 0 0.020);

            finitePatch true;
            minBound    (-0.020 0.025 0.020);
            maxBound    ( 0.020 0.075 0.020);
        }

        // Shoulder at y = 25 mm. These four non-overlapping rectangles
        // cover the 40 mm square except for the central 10 mm opening.
        shoulder_zPlus
        {
            material    wall;
            nVec        (0 -1 0);
            planePoint  (0 0.025 0);

            finitePatch true;
            minBound    (-0.020 0.025 0.005);
            maxBound    ( 0.020 0.025 0.020);
        }

        shoulder_zMinus
        {
            material    wall;
            nVec        (0 -1 0);
            planePoint  (0 0.025 0);

            finitePatch true;
            minBound    (-0.020 0.025 -0.020);
            maxBound    ( 0.020 0.025 -0.005);
        }

        shoulder_xPlus
        {
            material    wall;
            nVec        (0 -1 0);
            planePoint  (0 0.025 0);

            finitePatch true;
            minBound    (0.005 0.025 -0.005);
            maxBound    (0.020 0.025  0.005);
        }

        shoulder_xMinus
        {
            material    wall;
            nVec        (0 -1 0);
            planePoint  (0 0.025 0);

            finitePatch true;
            minBound    (-0.020 0.025 -0.005);
            maxBound    (-0.005 0.025  0.005);
        }

        // bottomOutlet and topOpen intentionally have no DEM collision wall.
    }
}

virtualMesh
{
    level        4;
    charCellSize 0.0005;
}

PH_SC_prefill
{
    stlBaseName PH_SC;

    fullyCoupledBody
    {
        velocity (0 -0.005 0);
    }

    rho         rho [1 -3 0 0 0 0 0] 2500;

    refineMC    5;

    U
    {
        BC noSlip;
    }

    bodyAddition
    {
        // Fill the complete upstream reservoir once at t = 0. The requested
        // fraction is converted to a nearest-integer particle count from the
        // exact particle and boundBox volumes.
        addModel onceScatter;

        onceScatterCoeffs
        {
            addMode geometricVolumeBased;
            geometricVolumeBasedCoeffs
            {
                fieldValue 0.30;
            }

            // Retained for easy switching back to the legacy lambda-based mode.
            fieldBasedCoeffs
            {
                fieldName  lambda;
                fieldValue 0.3;
            }

            addDomain boundBox;
            boundBoxCoeffs
            {
                minBound (-0.020 0.025 -0.020);
                maxBound ( 0.020 0.075  0.020);
            }

            scalingMode noScaling;
            randomScalingCoeffs
            {
                minScale 0.98521235637496851;
                maxScale 0.98521235637496851;
            }

            noScalingCoeffs
            {
            }

            rotationMode uniformRandomRotation;
            uniformRandomRotationCoeffs
            {
            }

            noRotationCoeffs
            {
            }

            // Fast deterministic exact-count packing. nearest rounding is
            // hard-coded and intentionally has no dictionary option.
            packingStrategy       hybridLattice;
            clearanceScale        1.0;
            maxConsecutiveFailures 10000;
            maxTotalAttempts       100000;
            reportEveryAccepted    1;
            randomSeed             12345;
        }
    }

    material        particle;
    bodyGeom        sphere;
    sphere
    {
        startPosition   ( 0 0.05 0 );
        radius          0.00166667;
    }
    updateTorque    true;
    sdBasedLambda   false;
    interfaceSpan   1;
    startSynced     true;
    refineBuffers   0;
    timesToSetStatic -1;
}

PH_SC_inlet
{
    stlBaseName PH_SC;

    fullyCoupledBody
    {
        velocity (0 -0.005 0);
    }

    rho         rho [1 -3 0 0 0 0 0] 2500;

    refineMC    5;

    U
    {
        BC noSlip;
    }

    bodyAddition
    {
        // Maintain phi = 0.20 only in the upper 10 mm source slab.
        addModel repeatRandomPosition;

        repeatRandomPositionCoeffs
        {
            startAfterTime 0;

            addMode fieldBased;
            fieldBasedCoeffs
            {
                fieldName  lambda;
                fieldValue 0.3;
            }

            addDomain boundBox;
            boundBoxCoeffs
            {
                minBound (-0.020 0.065 -0.020);
                maxBound ( 0.020 0.075  0.020);
            }

            scalingMode noScaling;
            randomScalingCoeffs
            {
                minScale 0.98521235637496851;
                maxScale 0.98521235637496851;
            }

            noScalingCoeffs
            {
            }

            rotationMode uniformRandomRotation;
            uniformRandomRotationCoeffs
            {
            }

            noRotationCoeffs
            {
            }
        }
    }

    material        particle;
    bodyGeom        sphere;
    sphere
    {
        startPosition   ( 0 0.07 0 );
        radius          0.00166667;
    }
    updateTorque    true;
    sdBasedLambda   false;
    interfaceSpan   1;
    startSynced     true;
    refineBuffers   0;
    timesToSetStatic -1;
}

